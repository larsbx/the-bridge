{
  "name": "bridge-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/budget.mjs",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings",
    "dev": "vite dev --host 127.0.0.1",
    "start": "node build",
    "test:integration": "node --test test/http.test.mjs",
    "test:browser": "playwright test",
    "build:test": "PUBLIC_URL=http://127.0.0.1:3173 npm run build",
    "test": "npm run build:test && npm run test:integration && npm run test:browser",
    "test:browser:ash": "BRIDGE_BROWSER_BACKEND=ash playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
