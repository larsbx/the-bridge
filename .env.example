# Plaid Sandbox is the default. Do not commit secrets.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Single-owner dashboard. Set a long unique passphrase.
DASHBOARD_PASSWORD=
# Generate separate keys: openssl rand -hex 32
SESSION_KEY=
DATA_KEY=
# Public HTTPS origin for Plaid webhooks (omit during localhost sandbox testing).
PUBLIC_URL=
# Optional registered Plaid OAuth redirect URL.
PLAID_REDIRECT_URI=
PORT=3000
DB_PATH=./data/bridge.sqlite
