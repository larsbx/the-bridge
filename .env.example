# Export these variables in the server environment; never commit populated files.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
DASHBOARD_PASSWORD=
# Distinct keys, each from: openssl rand -hex 32
SESSION_KEY=
DATA_KEY=
DATABASE_URL=ecto://postgres:postgres@localhost/bridge_dev
# Private Ash listener
BRIDGE_API_PORT=4000
BRIDGE_API_HOST=127.0.0.1
# Public SvelteKit process (do not give it Plaid/database/encryption secrets)
BRIDGE_API_ORIGIN=http://127.0.0.1:4000
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
# Set the same PUBLIC_URL when building SvelteKit and when starting Ash.
BODY_SIZE_LIMIT=128K
# Optional authenticated-dashboard handoff. Ship has independent sign-in and roles.
# Public origin only; HTTPS except for an isolated loopback fixture. No API token.
SHIP_CONTROL_ORIGIN=

